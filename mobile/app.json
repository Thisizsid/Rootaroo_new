{
  "expo": {
    "name": "Rootaroo",
    "slug": "rootaroo",
    "scheme": "rootaru",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0B1220"
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#06090F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rootaroo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.rootaroo.app",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "expo-notifications",
      "expo-file-system",
      "expo-location",
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Rootaroo to use your camera to scan invite QR codes."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Rootaroo to record voice messages."
        }
      ],
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "excludes": [
                "**/libc++_shared.so"
              ]
            }
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font"
    ]
  }
}
