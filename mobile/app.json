{
  "expo": {
    "name": "Rootaroo",
    "slug": "rootaroo",
    "scheme": "rootaru",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "androidNavigationBar": {
      "barStyle": "dark-content",
      "backgroundColor": "#FFFFFF"
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#1B1E24"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rootaroo.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.rootaroo.app",
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-image-picker",
      "expo-notifications",
      "expo-file-system",
      "expo-location",
      "expo-web-browser",
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "excludes": [
                "**/libc++_shared.so"
              ]
            }
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font"
    ]
  }
}
