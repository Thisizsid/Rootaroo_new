{
  "expo": {
    "name": "Rootaroo",
    "slug": "rootaroo",
    "scheme": "rootaru",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "androidNavigationBar": {
      "barStyle": "light-content",
      "backgroundColor": "#0B1220"
    },
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#06090F"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rootaroo.app",
      "googleServicesFile": "./GoogleService-Info.plist"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE"
      },
      "package": "com.rootaroo.app",
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "USE_BIOMETRIC",
        "USE_FINGERPRINT"
      ],
      "googleServicesFile": "./google-services.json"
    },
    "plugins": [
      "./plugins/withAutofillHighlight",
      "expo-apple-authentication",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Rootaroo uses your camera to take photos for posts, journal entries, and vault documents.",
          "photosPermission": "Rootaroo uses your photo library so you can attach photos to posts, journal entries, and your profile."
        }
      ],
      "expo-notifications",
      "expo-file-system",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Rootaroo uses your location when you check in or answer a household ping. It is never tracked in the background."
        }
      ],
      "expo-web-browser",
      [
        "expo-camera",
        {
          "cameraPermission": "Rootaroo uses your camera to scan household invite QR codes, take photos for posts and journal entries, and scan documents into your vault."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Rootaroo to record voice messages."
        }
      ],
      "@react-native-community/datetimepicker",
      "@maplibre/maplibre-react-native",
      [
        "expo-build-properties",
        {
          "android": {
            "packagingOptions": {
              "excludes": [
                "**/libc++_shared.so"
              ]
            }
          },
          "ios": {
            "deploymentTarget": "15.1"
          }
        }
      ],
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.247745926282-52752edgjmo5h2ao9fut4b0ddjr92hdr"
        }
      ]
    ]
  }
}
