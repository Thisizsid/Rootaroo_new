# Google OAuth Client IDs for Sign-In
# Create credentials in Google Cloud Console:
#   Android:  https://console.cloud.google.com/apis/credentials  (Android app type)
#   iOS:      https://console.cloud.google.com/apis/credentials  (iOS app type)
#   Web:      https://console.cloud.google.com/apis/credentials  (Web app type)
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=

# API base URL — leave unset. src/shared/api/client.js auto-detects your
# machine's LAN IP from Metro's own bundler host, so a physical phone on the
# same Wi-Fi as your dev server just works with no edits here. Only set this
# if you need to point at something non-local (e.g. a staging server), or
# override for the Android emulator with 10.0.2.2:3000 (emulator's localhost
# is itself, host machine is at 10.0.2.2).
# EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
