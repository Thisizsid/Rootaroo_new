# Environment Variables
# Copy this file to .env and fill in the values

NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=rootaroo_dev

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# JWT
JWT_ACCESS_SECRET=change-me-to-a-random-secret
JWT_REFRESH_SECRET=change-me-to-another-random-secret
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/google/callback

# AWS SNS (phone OTP delivery — same IAM user as S3, needs sns:Publish added
# to its policy; leave blank to use the dev-mode console-logged code instead)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Firebase Cloud Messaging (push). FCM_PROJECT_ID: Firebase Console -> Project
# Settings -> General. FCM_CREDENTIALS_BASE64 accepts EITHER of the following,
# base64-encoded into one line (`base64 -w0 <file>`):
#   (a) a real service-account key JSON (Project Settings -> Service Accounts
#       -> Generate new private key) — the standard production credential, or
#   (b) impersonated Application Default Credentials, if (a) is blocked by an
#       org policy on service-account key creation:
#       `gcloud auth application-default login \
#         --impersonate-service-account=<sa-email>` then base64 the resulting
#       ~/.config/gcloud/application_default_credentials.json
# Swapping from (b) to (a) later needs no code change, only a new value here.
FCM_ENABLED=false
FCM_PROJECT_ID=
FCM_CREDENTIALS_BASE64=

# AWS S3 (or MinIO for local dev)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET=rootaroo-dev
S3_REGION=us-east-1
S3_USE_SSL=false

# Email (SMTP)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@rootaroo.com

# Sentry
SENTRY_DSN=

# App
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
LOG_LEVEL=debug

# Rootaroo admin (household leave/delete request review)
ADMIN_EMAIL=
ADMIN_API_KEY=
